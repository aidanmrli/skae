\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Support--basin alignment, wrong-support ablations, and forecasting on the retained \(15\)-system multibasin benchmark. Values are arithmetic means across systems after first summarizing seeds within each system by IQM; \(\overline  {|F_{\rm  abs}|}\) is an arithmetic mean over per-system seed means. Brackets give within-system Wilcoxon/Holm counts. Arrows denote the better direction. \(\overline  {|F_{\rm  abs}|}\) should be compared with the number of basin labels present in the evaluated deep slice.}}{10}{table.caption.12}\protected@file@percent }
\newlabel{tab:fixed17_alignment}{{1}{10}{Support--basin alignment, wrong-support ablations, and forecasting on the retained \(15\)-system multibasin benchmark. Values are arithmetic means across systems after first summarizing seeds within each system by IQM; \(\overline {|F_{\rm abs}|}\) is an arithmetic mean over per-system seed means. Brackets give within-system Wilcoxon/Holm counts. Arrows denote the better direction. \(\overline {|F_{\rm abs}|}\) should be compared with the number of basin labels present in the evaluated deep slice}{table.caption.12}{}}
\newlabel{tab:fixed17_alignment@cref}{{[table][1][]1}{[1][9][]10}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Per-seed support results on the deep-state slice. Dots show system--seed pairs, and gray I-bars mark first-to-third quartile ranges. Black bars mark the paper-facing summary: seed-IQM within each system followed by an arithmetic mean across systems for entropy and wrong-support ratios, and arithmetic means for \(|F_{\rm  abs}|\). Lower is better for \(H(B\mid F_{\rm  abs})\); \(|F_{\rm  abs}|\) is a non-directional support-family count to compare with the represented basin count. The wrong-support panel shows wrong-support/base ratios at \(h{=}1\) on a log scale; higher means that using a wrong-basin support is more damaging.}}{10}{figure.caption.14}\protected@file@percent }
\newlabel{fig:fixed17_entropy_strips}{{2}{10}{Per-seed support results on the deep-state slice. Dots show system--seed pairs, and gray I-bars mark first-to-third quartile ranges. Black bars mark the paper-facing summary: seed-IQM within each system followed by an arithmetic mean across systems for entropy and wrong-support ratios, and arithmetic means for \(|F_{\rm abs}|\). Lower is better for \(H(B\mid F_{\rm abs})\); \(|F_{\rm abs}|\) is a non-directional support-family count to compare with the represented basin count. The wrong-support panel shows wrong-support/base ratios at \(h{=}1\) on a log scale; higher means that using a wrong-basin support is more damaging}{figure.caption.14}{}}
\newlabel{fig:fixed17_entropy_strips@cref}{{[figure][2][]2}{[1][9][]10}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Support-conditioned prediction diagnostics. Left: all-state support-family routing. \(F_{\rm  top8}\)-local uses merged families of exact top-\(8\) supports to fit and select local predictors without basin labels. Ratios are \(10^{\operatorname  {mean}_s D_s}\), where \(D_s\) is the within-system IQM of finite seed-level \(\log _{10}\) routed/global MSE ratios. System wins count systems whose censored per-system IQM log comparison favors routing; a finite routed rollout with an invalid same-model global rollout counts as a routed win, and the reverse counts as a loss. Superscripts mark a one-sided exact sign-flip test on system-level finite log effects, Holm-corrected across displayed model--horizon cells. Right: exact \(S_{\rm  top8}\) refresh after controlled basin transfer. Target-route is the fraction of post-entry steps routed to the target basin; the MSE ratio compares refreshed \(S_{\rm  top8}\) with stale source \(S_{\rm  top8}\); brackets give Wilcoxon/Holm counts. Lower MSE ratios are better, and LISTA-SB is the soft-block LISTA ablation.}}{11}{table.caption.18}\protected@file@percent }
\newlabel{tab:routing_refresh}{{2}{11}{Support-conditioned prediction diagnostics. Left: all-state support-family routing. \(F_{\rm top8}\)-local uses merged families of exact top-\(8\) supports to fit and select local predictors without basin labels. Ratios are \(10^{\operatorname {mean}_s D_s}\), where \(D_s\) is the within-system IQM of finite seed-level \(\log _{10}\) routed/global MSE ratios. System wins count systems whose censored per-system IQM log comparison favors routing; a finite routed rollout with an invalid same-model global rollout counts as a routed win, and the reverse counts as a loss. Superscripts mark a one-sided exact sign-flip test on system-level finite log effects, Holm-corrected across displayed model--horizon cells. Right: exact \(S_{\rm top8}\) refresh after controlled basin transfer. Target-route is the fraction of post-entry steps routed to the target basin; the MSE ratio compares refreshed \(S_{\rm top8}\) with stale source \(S_{\rm top8}\); brackets give Wilcoxon/Holm counts. Lower MSE ratios are better, and LISTA-SB is the soft-block LISTA ablation}{table.caption.18}{}}
\newlabel{tab:routing_refresh@cref}{{[table][2][]2}{[1][11][]11}{}{}{}}
