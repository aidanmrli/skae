\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Support families align with basins and do so consistently across systems and seeds. \textbf  {Left:} alluvial view for a LISTA KAE on local-linear gates; held-out deep states are grouped by post-hoc evaluation basin, exact \(S_{\rm  abs}\) mask, and merged \(F_{\rm  abs}\) family, with \(393\) exact supports merging to three families, which is one-to-one with represented basins. \textbf  {Right:} per-seed deep-slice support results on the retained benchmark. Dots show system--seed pairs, gray I-bars mark first-to-third quartile ranges, and black bars mark IQM summaries for \(H(B\mid F_{\rm  abs})\) and arithmetic means for \(|F_{\rm  abs}|\).}}{11}{figure.caption.17}\protected@file@percent }
\newlabel{fig:basin_support_alignment_summary}{{2}{11}{Support families align with basins and do so consistently across systems and seeds. \textbf {Left:} alluvial view for a LISTA KAE on local-linear gates; held-out deep states are grouped by post-hoc evaluation basin, exact \(S_{\rm abs}\) mask, and merged \(F_{\rm abs}\) family, with \(393\) exact supports merging to three families, which is one-to-one with represented basins. \textbf {Right:} per-seed deep-slice support results on the retained benchmark. Dots show system--seed pairs, gray I-bars mark first-to-third quartile ranges, and black bars mark IQM summaries for \(H(B\mid F_{\rm abs})\) and arithmetic means for \(|F_{\rm abs}|\)}{figure.caption.17}{}}
\newlabel{fig:basin_support_alignment_summary@cref}{{[figure][2][]2}{[1][10][]11}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Support-conditioned prediction diagnostics. \textbf  {Left:} label-free \(F_{\rm  top8}\)-local routed/global MSE ratios and system-win counts on all states; lower ratios and higher win counts are better. Superscripts denote significance tests: \(\ast \), \(p_{\rm  Holm}<0.05\); \(\ast \ast \), \(p_{\rm  Holm}<0.01\). \textbf  {Right:} exact \(S_{\rm  top8}\) refresh after controlled basin transfer. Target-route is the post-entry target-basin route fraction (higher is better); the MSE ratio compares refreshed with stale source supports (lower is better); brackets give Wilcoxon/Holm counts. \textbf  {Bold} marks the best directional entry.}}{11}{table.caption.20}\protected@file@percent }
\newlabel{tab:routing_refresh}{{2}{11}{Support-conditioned prediction diagnostics. \textbf {Left:} label-free \(F_{\rm top8}\)-local routed/global MSE ratios and system-win counts on all states; lower ratios and higher win counts are better. Superscripts denote significance tests: \(\ast \), \(p_{\rm Holm}<0.05\); \(\ast \ast \), \(p_{\rm Holm}<0.01\). \textbf {Right:} exact \(S_{\rm top8}\) refresh after controlled basin transfer. Target-route is the post-entry target-basin route fraction (higher is better); the MSE ratio compares refreshed with stale source supports (lower is better); brackets give Wilcoxon/Holm counts. \textbf {Bold} marks the best directional entry}{table.caption.20}{}}
